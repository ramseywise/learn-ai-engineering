<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wiseer.papers-nightly</string>

    <!-- Weekly /papers and /chapter integration for learn-ai-engineering: headless Claude, one
         home or chapter per session, biggest backlog first, then the /extract backfill and the
         ingestion into librarian's wiki and search index. Tuesdays 02:30, the night after the
         Monday potw download. The label keeps its old "nightly" name so existing installs and
         logs still match. This time is not tuned to the usage window, which moves with use; the
         script stops when it meets a limit. Installed by `make papers-nightly-install`. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ramsey-wise/workspace/learn-ai-engineering/scripts/papers/papers-nightly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ramsey-wise/workspace/learn-ai-engineering</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>2</integer>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ramsey-wise/workspace/learn-ai-engineering/.claude/logs/papers-nightly.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ramsey-wise/workspace/learn-ai-engineering/.claude/logs/papers-nightly.log</string>
</dict>
</plist>
