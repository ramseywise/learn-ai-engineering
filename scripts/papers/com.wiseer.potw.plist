<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wiseer.potw</string>

    <!-- Weekly AI Papers of the Week sync for learn-ai-engineering: fetch, triage,
         download PDFs into pillar sources/. Monday 11:00 — after cartographer.cron
         (09:30) and eval-runner (10:00) so logs don't collide. Installed by
         `make papers-install`. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ramsey-wise/workspace/learn-ai-engineering/scripts/papers/potw-cron.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ramsey-wise/workspace/learn-ai-engineering</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>11</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ramsey-wise/workspace/learn-ai-engineering/.claude/logs/potw.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ramsey-wise/workspace/learn-ai-engineering/.claude/logs/potw.log</string>
</dict>
</plist>
