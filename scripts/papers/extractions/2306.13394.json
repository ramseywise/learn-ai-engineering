 "type": "benchmark",
 "question": "How can perception and cognition of multimodal LLMs be measured comprehensively, without data leakage or prompt-engineering effects, and how do current MLLMs fare?",
 "hypothesis": null,
 "contributions": [
  "A new benchmark MME to meet the urgent need of MLLM evaluation",
  "30 up-to-date MLLMs evaluated on MME",
  "Summary of exposed problems to guide MLLM evolution"
 ],
 "method": {
  "summary": "MME has 14 subtasks (10 perception, 4 cognition) with manually written yes/no question pairs per image. Each image gets one yes-truth and one no-truth question, scored by accuracy (per question) and accuracy+ (per image, both right). 30 MLLMs are evaluated zero-shot.",
  "task": "multimodal LLM evaluation (yes/no VQA)",
