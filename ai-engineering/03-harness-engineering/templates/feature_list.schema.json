{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature List",
  "description": "Feature state for agent-driven development. Pair with feature_list.json.",
  "type": "object",
  "required": ["features"],
  "properties": {
    "project": { "type": "string" },
    "last_updated": { "type": "string" },
    "rules": { "type": "object" },
    "status_legend": { "type": "object" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority", "title", "user_visible_behavior", "status", "verification"],
        "properties": {
          "id": { "type": "string", "description": "Unique id, e.g. chat-001" },
          "priority": { "type": "integer", "minimum": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Feature ids that must be passing before this one starts"
          },
          "area": { "type": "string" },
          "title": { "type": "string" },
          "user_visible_behavior": {
            "type": "string",
            "description": "What the user sees, not how it is implemented"
          },
          "status": {
            "type": "string",
            "enum": ["not_started", "active", "blocked", "passing"]
          },
          "verification": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Executable steps or commands that decide passing"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Commits, logs or screenshots recorded when the feature passed"
          },
          "notes": { "type": "string" }
        },
        "if": { "properties": { "status": { "const": "passing" } } },
        "then": { "properties": { "evidence": { "minItems": 1 } }, "required": ["evidence"] }
      }
    }
  }
}
