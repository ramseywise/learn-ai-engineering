# Experiment 6-6 environment variables
#
# Only `--source llm` (LLM-judged battles) needs an API key;
# simulate / arena / elo / leaderboard / pipeline are fully offline and need none.
#
# Usage: copy this file to .env and fill in real keys, or `export` them in your shell.

# --- Judge backend 1: Anthropic (preferred by default) ---
# When this key is set, --judge-backend auto uses the Anthropic SDK.
ANTHROPIC_API_KEY=sk-ant-...

# --- Judge backend 2: OpenRouter fallback ---
# Used when ANTHROPIC_API_KEY is missing or invalid, via the OpenAI-compatible SDK pointed at OpenRouter.
# Internal Claude names are mapped to OpenRouter ids automatically:
#   claude-opus-4-8  -> anthropic/claude-opus-4.8
#   claude-haiku-4-5 -> anthropic/claude-haiku-4.5
#   claude-sonnet-4-6 -> anthropic/claude-sonnet-4.6
# Ids that already contain '/' (e.g. openai/gpt-5.6-luna) pass through unchanged.
#
# To force OpenRouter:
#   python cli.py battle --source llm --judge-backend openrouter \
#     --judge-model claude-opus-4-8 \
#     --candidate-models anthropic/claude-haiku-4.5 openai/gpt-5.6-luna
OPENROUTER_API_KEY=sk-or-...
