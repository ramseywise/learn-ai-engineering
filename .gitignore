# Mac Files
*.DS_Store
.RData
*.csv
.vscode
*.ipynb_checkpoints
.ipynb_checkpoints

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Pickle
*.pkl
*.pickle
*.feather

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
*.html

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# AWS
.aws/

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# IPython Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# dotenv (any depth; e.g. ai-engineering/05-graph-engineering/notebooks/knowledge-graphs-for-rag/code/.env holds live keys)
.env
**/.env

# dotpip
.pip

#PyCharm
.idea

# virtualenv
venv/
ENV/

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

# Keys
utils/API_KEYS.ini

# Temp hydrogen file
*.tmp

# slide previews and half-written PDFs (make slides PREVIEW=1 PDF=1); the PDFs themselves are committed
**/slides/.preview/
**/slides/lectures/.preview/
ai-engineering/*/slides/.*.pdf.tmp

# filtered decks (make slides LEVEL=...): built on demand from deck.yaml, never committed
**/slides/*-core.pptx
**/slides/*-core.pdf
**/slides/*-practice.pptx
**/slides/*-practice.pdf
**/slides/*-deep.pptx
**/slides/*-deep.pdf
**/slides/lectures/*-core.pptx
**/slides/lectures/*-core.pdf
**/slides/lectures/*-practice.pptx
**/slides/lectures/*-practice.pdf
**/slides/lectures/*-deep.pptx
**/slides/lectures/*-deep.pdf

# intro-to-nlp datasets: over the 1 MB pre-commit limit; download per data-science/03-nlp/README.md
data-science/03-nlp/practice/intro-to-nlp/data/*
!data-science/03-nlp/practice/intro-to-nlp/data/irish-lyrics.txt

# potw.py ledger lock
scripts/papers/.ledger.lock
scripts/papers/discover/cache/

# per-file lock left by note-writing tools
**/references.md.lock

# practice/ is an allowlist: practice/.gitignore names each cleared file. Without it, all stay ignored.
/practice/*

# programming/drills: kept on disk, never tracked. Nested repos and solutions to site problems with
# no licence (see THIRD_PARTY.md), personal attempts, and the drill log.
/programming/drills/python/leetcode/
/programming/drills/python/hackerrank/
/programming/drills/sql/hackerrank/
/programming/drills/typescript/hackerrank/
/programming/drills/coding/scratch/
/programming/drills/coding/drill-log.md

# claude docs
.claude/docs/

# Ignored leftovers of the removed MLOps Zoomcamp snapshot; delete the folder, then this line.
/data-engineering/06-ml-platform/practice/datatalks-mlops/

# Generated by data-science/02-deep-learning/practice/vision_transfer.py (rebuilt in about a second)
data-science/02-deep-learning/practice/data/
