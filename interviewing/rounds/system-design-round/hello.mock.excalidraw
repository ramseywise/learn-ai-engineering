    {
      "id": "6qpJ7hZ7l0xObhN4ilHil",
      "type": "text",
      "x": 1441.849079731522,
      "y": 1175.6299050974137,
      "width": 411.53961181640625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 618741301,
      "version": 161,
      "versionNonce": 58764187,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1749699353151,
      "link": null,
      "locked": false,
      "text": "Scheduling something to happen at X time:\n\nbuilt on top of a queue:\nJobschedulers - e.g. SQS visibility timeout",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 92,
      "containerId": null,
      "originalText": "Scheduling something to happen at X time:\n\nbuilt on top of a queue:\nJobschedulers - e.g. SQS visibility timeout",
      "lineHeight": 1.25,
      "index": "ah",
      "autoResize": true
    },
    {
      "id": "zzR50GWltRFYl0wXyDxEv",
      "type": "text",
      "x": 1851.4257553146092,
      "y": 893.4320946730865,
      "width": 677.0593872070312,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1927655317,
      "version": 182,
      "versionNonce": 1530822715,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1749699353151,
      "link": null,
      "locked": false,
      "text": "Alternative approach:\nmessage queue contains pointer to some info\n- find / edit the record in the queue each time there's a new winner\n- update the time to check",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 92,
      "containerId": null,
      "originalText": "Alternative approach:\nmessage queue contains pointer to some info\n- find / edit the record in the queue each time there's a new winner\n- update the time to check",
      "lineHeight": 1.25,
      "index": "ai",
      "autoResize": true
    },
    {
      "id": "2usl4zbXDnVkiRa8wwfEp",
      "type": "text",
      "x": 2218.744022341945,
      "y": 1142.1897543035313,
      "width": 695.539306640625,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1578431733,
      "version": 535,
      "versionNonce": 1905836251,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1749699353151,
      "link": null,
      "locked": false,
      "text": "- job scheduler with builtin durability\n- workflow (code) is scheduled to run\n  - can restart from where it left off (checkpointing state)\n- schedule at any given time (workflow to check winner at X datetime)\n- Signals:\n    - talk to a workflow while it's running\n    - edit winnerdata: <John, 10PM> -> <Stuart, 11PM>\n\ne.g.\ncode bug is pushed\npayments crash\n\n",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 317,
      "containerId": null,
      "originalText": "- job scheduler with builtin durability\n- workflow (code) is scheduled to run\n  - can restart from where it left off (checkpointing state)\n- schedule at any given time (workflow to check winner at X datetime)\n- Signals:\n    - talk to a workflow while it's running\n    - edit winnerdata: <John, 10PM> -> <Stuart, 11PM>\n\ne.g.\ncode bug is pushed\npayments crash\n\n",
      "lineHeight": 1.25,
      "index": "aj",
      "autoResize": true
    },
