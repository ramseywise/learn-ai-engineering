    },
    {
      "id": "Yqaw225APpym4TFfeTzHQ",
      "type": "text",
      "x": -1134.0018408361868,
      "y": 332.6889291489333,
      "width": 332.75970458984375,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1566607189,
      "version": 284,
      "versionNonce": 206439547,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1749699353151,
      "link": null,
      "locked": false,
      "text": "API:\n\nPOST /api/auction -> Auction\nHeader: JWT | Session\nbody: {\n  AuctionItem,\n  end_datetime\n}\n\nPOST /api/bid -> Bid\n{\n  auction_id,\n  bid_amount\n}\n\nGET /api/auction -> Auction\n\nGET /api/auction/:auction_id/live",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 442,
      "containerId": null,
      "originalText": "API:\n\nPOST /api/auction -> Auction\nHeader: JWT | Session\nbody: {\n  AuctionItem,\n  end_datetime\n}\n\nPOST /api/bid -> Bid\n{\n  auction_id,\n  bid_amount\n}\n\nGET /api/auction -> Auction\n\nGET /api/auction/:auction_id/live",
      "lineHeight": 1.25,
      "index": "a6",
      "autoResize": true
    },
