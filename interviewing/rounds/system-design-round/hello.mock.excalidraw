    {
      "id": "OKxbAN5SMz9EbS2G8-COh",
      "type": "text",
      "x": -1840.6347053059715,
      "y": 110.17473847510519,
      "width": 553.3795166015625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
