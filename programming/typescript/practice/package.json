{
  "name": "programming-typescript-practice",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "node check.ts",
    "typecheck:solutions": "node check.ts --solutions",
    "test": "node --test \"tests/*.test.ts\"",
    "test:solutions": "TARGET=solutions node --test \"tests/*.test.ts\"",
    "check": "npm run typecheck:solutions && npm run test:solutions"
  },
  "devDependencies": {
    "@type-challenges/utils": "^0.1.1",
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  }
}
