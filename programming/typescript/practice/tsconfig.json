{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "type-assertions": ["./typescript-exercises/type-assertions/index.ts"],
      "type-assertions/index": ["./typescript-exercises/type-assertions/index.ts"],
      "date-wizard": ["./typescript-exercises/13/vendor/date-wizard"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "**/*.solution.ts", "**/*.solution.d.ts", "type-challenges/solutions", "solutions"]
}
